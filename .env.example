# ==============================
# Flask Backend
# ==============================
FLASK_APP=run.py
FLASK_ENV=development

# Development only - CHANGE IN PRODUCTION
SECRET_KEY=dev-secret-key-change-in-production
RECEIPT_SECRET_KEY=dev-receipt-secret-change-in-production

BACKEND_PORT=5000


# ==============================
# PostgreSQL
# ==============================
POSTGRES_USER=voting_user
POSTGRES_PASSWORD=voting_password
POSTGRES_DB=voting_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql://voting_user:voting_password@db:5432/voting_db


# ==============================
# Voting Security
# ==============================

# Comma-separated CIDR ranges of authorized
# diplomatic mission networks.
#
# MUST REPLACE THESE WITH
# THE ACTUAL APPROVED NETWORK RANGES.
DIPLOMATIC_MISSION_IP_RANGES=


# ==============================
# Frontend
# ==============================
VITE_API_BASE_URL=http://localhost:5000
FRONTEND_PORT=3000